DATABASE_URL=postgresql+psycopg://superflow:superflow_demo@127.0.0.1:5432/superflow
TEST_DATABASE_URL=postgresql+psycopg://superflow:superflow_demo@127.0.0.1:5432/superflow_test
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Optional server-side FastAPI URL for the CopilotKit workspace agent.
# SUPERFLOW_API_URL=http://127.0.0.1:8000

# Optional real local inference. Keep deterministic for a credential-free fallback;
# set to ollama after starting the Docker profile and pulling the model.
LLM_PROVIDER=deterministic
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=512
OLLAMA_TEMPERATURE=0.1
OLLAMA_TIMEOUT_SECONDS=120

# Docker Ollama runtime. Port is bound to loopback only.
OLLAMA_PORT=11434
OLLAMA_KEEP_ALIVE=10m
OLLAMA_NUM_PARALLEL=1
# OLLAMA_IMAGE=ollama/ollama:0.34.1
# Optional interpreter override for scripts/python.mjs:
# PYTHON=C:/path/to/python.exe
