# Copy to the deployment's .env; supply deployment-specific values outside Git.
APP_ENVIRONMENT=staging
AUTH_MODE=password
INVESTIGATION_PROVIDER=browser
PUBLIC_APP_URL=https://superflow-stg.example.com
CORS_ORIGINS=https://superflow-stg.example.com
DATABASE_URL=postgresql+psycopg://superflow:REPLACE_WITH_STAGING_PASSWORD@127.0.0.1:5432/superflow_stg
NEXT_PUBLIC_API_URL=/api/backend
SUPERFLOW_API_URL=http://127.0.0.1:8000
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:0.8b
OLLAMA_TIMEOUT_SECONDS=600
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=512
VISION_MODEL=qwen3.5:0.8b
VISION_TIMEOUT_SECONDS=600
RETRIEVAL_PROVIDER=hybrid
RETRIEVAL_ENGINE=llamaindex
RETRIEVAL_TOP_K=6
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_THREADS=2
SEMANTIC_MIN_SCORE=0.30
OCR_ENABLED=true
WEB_CAPTURE_ENABLED=true
WEB_SEARCH_MAX_RESULTS=2
SESSION_HOURS=8
# Set PYTHON and WEB_BROWSER_EXECUTABLE to installed host paths when needed.
