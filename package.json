{
  "name": "superflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @superflow/web",
    "dev:api": "node scripts/python.mjs -m uvicorn superflow.main:app --host 127.0.0.1 --port 8000",
    "db:local": "node scripts/postgres.mjs",
    "db:migrate": "node scripts/python.mjs -m alembic -c apps/api/alembic.ini upgrade head",
    "db:seed": "node scripts/python.mjs -m superflow.seed",
    "db:reset": "node scripts/python.mjs -m superflow.seed --reset",
    "build": "npm run build --workspace @superflow/web",
    "start": "npm run start --workspace @superflow/web",
    "lint": "npm run lint --workspace @superflow/web",
    "typecheck": "npm run typecheck --workspace @superflow/web",
    "test:api": "node scripts/python.mjs -m pytest apps/api/tests -q",
    "test:web": "node --experimental-strip-types --test tests/frontend/*.test.ts",
    "test:e2e": "node scripts/prepare-e2e.mjs && playwright test",
    "lint:api": "node scripts/python.mjs -m ruff check apps/api",
    "format:api": "node scripts/python.mjs -m ruff format --check apps/api",
    "format:check": "prettier --check apps/web scripts/*.mjs playwright.config.ts tests/**/*.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "embedded-postgres": "18.4.0-beta.17",
    "prettier": "^3.8.1"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@18.4.0-beta.17": true,
    "unrs-resolver@1.12.2": true
  }
}
